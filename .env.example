# ---------------------------------------------------------------------------
# MCPNEXUS environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

# HTTP port for the API + built SPA (default 4317)
MCPNEXUS_PORT=4317

# Bind address. Keep 127.0.0.1 for a local-only control plane.
HOST=127.0.0.1

# Where SQLite, the master key and the Nexus workspace live (default ./data)
# MCPNEXUS_DATA_DIR=./data

# Sandbox directory exposed by the Nexus Filesystem MCP server
# MCPNEXUS_WORKSPACE=./data/workspace

# 32-byte hex key used for AES-256-GCM encryption of stored secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key is generated into data/master.key on first boot.
# MCPNEXUS_MASTER_KEY=

# First-run administrator (only applied when the users table is empty).
# Leave MCPNEXUS_ADMIN_PASSWORD unset and a random password is generated into
# data/initial-admin.txt (mode 0600). There is no default password.
MCPNEXUS_ADMIN_EMAIL=admin@mcpnexus.local
MCPNEXUS_ADMIN_PASSWORD=
MCPNEXUS_ADMIN_NAME=Nexus Administrator

# Session lifetime in hours (default 168 = 7 days)
MCPNEXUS_SESSION_TTL_HOURS=168

# Set to true when the UI is served over HTTPS so cookies are marked Secure
MCPNEXUS_COOKIE_SECURE=false

# MCP client timeouts
MCPNEXUS_CONNECT_TIMEOUT_MS=20000
MCPNEXUS_TOOL_TIMEOUT_MS=60000

# API requests per minute per session (default 240)
MCPNEXUS_RATE_LIMIT_PER_MINUTE=240

# NODE_ENV=production enables static asset caching and hides error details
NODE_ENV=development
